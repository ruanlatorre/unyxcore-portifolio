rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regra para a coleção de usuários
    match /users/{userId} {
      // Qualquer usuário logado pode ler para verificar perfis (necessário no dashboard)
      allow read: if request.auth != null; 
      // Apenas o próprio usuário pode se editar, OU se for um Admin
      allow write: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // Regra para Vendas
    match /sales/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Regra para Convites
    match /invites/{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Regra de segurança padrão: Bloqueia tudo que não foi explicitamente liberado acima
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
